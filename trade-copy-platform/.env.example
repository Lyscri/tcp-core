# ── Environment ──────────────────────────────
NODE_ENV=development

# ── Auth ─────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production-min32chars!!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradecopier
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123

# ── Kafka ────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Stripe ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── Service Ports ────────────────────────────
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
ACCOUNT_SERVICE_PORT=3002
TRADE_SYNC_PORT=3003
RISK_ENGINE_PORT=3004
BROKER_ADAPTER_PORT=3005
ANALYTICS_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007
ADMIN_SERVICE_PORT=3008
WEBSOCKET_GATEWAY_PORT=3009

# ── Service URLs ─────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
ACCOUNT_SERVICE_URL=http://localhost:3002
TRADE_SYNC_URL=http://localhost:3003
RISK_ENGINE_URL=http://localhost:3004
BROKER_ADAPTER_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
ADMIN_SERVICE_URL=http://localhost:3008
